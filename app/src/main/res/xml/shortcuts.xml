<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_new_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_expense"
        android:shortcutShortLabel="@string/shortcut_expense_short"
        android:shortcutLongLabel="@string/shortcut_expense_long">
        <intent
            android:action="com.uramos.minicash.ACTION_NEW_EXPENSE"
            android:targetPackage="com.uramos.minicash"
            android:targetClass="com.uramos.minicash.MainActivity">
            <extra android:name="shortcut_action" android:value="EXPENSE" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_new_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_income_short"
        android:shortcutLongLabel="@string/shortcut_income_long">
        <intent
            android:action="com.uramos.minicash.ACTION_NEW_INCOME"
            android:targetPackage="com.uramos.minicash"
            android:targetClass="com.uramos.minicash.MainActivity">
            <extra android:name="shortcut_action" android:value="INCOME" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_new_transfer"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_transfer"
        android:shortcutShortLabel="@string/shortcut_transfer_short"
        android:shortcutLongLabel="@string/shortcut_transfer_long">
        <intent
            android:action="com.uramos.minicash.ACTION_NEW_TRANSFER"
            android:targetPackage="com.uramos.minicash"
            android:targetClass="com.uramos.minicash.MainActivity">
            <extra android:name="shortcut_action" android:value="TRANSFER" />
        </intent>
    </shortcut>
</shortcuts>
